          "categories": [
            {
              "category": "High Priority",
              "description": "=Emails requiring immediate attention or action, typically from key stakleholder, clinets, or decision-makers. These emails often contain time-sensitive requests, deadlines, or escalated issues. \n\nKeywords :urgent, ASAP, Immediate, deadline, action required, high priority"
            },
            {
              "category": "Customer Support",
              "description": "Emails sent by customers or clients who need assistance, guidance, or solutions related to a product, service, or transaction. This category includes:\n\nQuestions about how to use a product or service\n\nReporting technical issues or errors\n\nRequests for refunds, returns, or exchanges\n\nClarifications on policies, warranties, or subscriptions\n\nFollow-ups on previously submitted support tickets\n\nKeywords: help, support, issue, complaint, assistance, question, problem, query, ticket, troubleshooting, request, guidance"
            },
            {
              "category": "Promotions",
              "description": "Emails that are intended to inform, advertise, or persuade recipients about products, services, events, or offers. These are generally not urgent and do not require immediate action. Typical examples include:\n\nMarketing campaigns or product launches\n\nDiscount or seasonal sales announcements\n\nNewsletters or email subscriptions with company updates\n\nInvitations to webinars, events, or promotions\n\nLoyalty programs, referral campaigns, or special offers\n\nKeywords: offer, discount, sale, promotion, newsletter, deal, special offer, marketing, advertisement, campaign, invite, event"
            },
            {
              "category": "Finance/Billing",
              "description": "Emails concerning financial transactions, payments, or account management. These often require review, confirmation, or action related to business or personal finance. Examples include:\n\nInvoices or bills for products/services\n\nPayment reminders or overdue notices\n\nReceipts or transaction confirmations\n\nAccount statements or summaries\n\nNotifications of refunds, credits, or financial adjustments\n\nKeywords: invoice, payment, billing, receipt, statement, due, account, finance, transaction, overdue, credit, refund, statement notice"
            }
          ]
        },
